API_URL=http://localhost:3001
PORT=3001
# Local SQLite for sessions/chat history (PrivateGPT)
DATABASE_URL=file:./packages/database/data/chopus.db
# PrivateGPT: local by default (no login). Set LOCAL_MODE=false to re-enable Clerk.
LOCAL_MODE=true
# Local PrivateGPT path: Hono → FastAPI (services/ai) → Ollama
LOCAL_AI_URL=http://localhost:8000
LOCAL_AI_API_KEY=local
# Optional cloud auth (ignored when LOCAL_MODE=true)
CLERK_FRONTEND_API=
CLERK_OAUTH_CLIENT_SECRET=
CLERK_OAUTH_CLIENT_ID=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
JWT_SECRET=jwt-secret
# Optional billing leftover from the course — local Ollama chat skips Polar
POLAR_ACCESS_TOKEN=
POLAR_PRODUCT_ID=
POLAR_SERVER=sandbox
POLAR_CREDITS_METER_ID=
